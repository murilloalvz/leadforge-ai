# Application
LEADFORGE_ENVIRONMENT=development
LEADFORGE_DATABASE_URL=sqlite:///./leadforge.db

# Discovery provider - Google Places (preferred when configured)
LEADFORGE_GOOGLE_PLACES_API_KEY=
LEADFORGE_GOOGLE_PLACES_ENDPOINT=https://places.googleapis.com/v1/places:searchText
LEADFORGE_GOOGLE_PLACES_TIMEOUT_SECONDS=12

# Discovery provider - OpenStreetMap/Overpass (experimental fallback)
LEADFORGE_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
LEADFORGE_OVERPASS_TIMEOUT_SECONDS=25

# Future external providers
LEADFORGE_OPENAI_API_KEY=
